<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- The about block for the settings list: a few lines of metadata and the
         "Made with <3 in Europe" chip under them. The frame reports its own
         height back to the list, so it is laid out in Lua, not here. -->
    <Frame name="WherefromAboutTemplate" mixin="WherefromAboutMixin" virtual="true">
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="8" y="0"/>
                        <Anchor point="TOPRIGHT" x="-8" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="Chip" inherits="BackdropTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.Text" relativePoint="BOTTOMLEFT" x="0" y="-8"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Text" inherits="GameFontNormalSmall" justifyH="CENTER">
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
</Ui>
